{
    // --- Geral ---
    "layer": "top",
    "position": "top",
    "margin-top": 10,
    "margin-left": 10,
    "margin-right": 10,
    "height": 56,
    "spacing": 0,
    "reload_style_on_change": true,

    // --- Layout ---
    "modules-left": [
        "custom/launcher",
        "custom/player",
        "group/expand"
    ],
    "modules-center": [
        "hyprland/workspaces",
        "custom/cava"
    ],
    "modules-right": [
        "group/expand#2",
        "group/audio",
        "tray",
        "backlight",
        "battery",
        "custom/notification",
        "clock",
        "custom/powermenu"
    ],

    // --- Grupos (Drawers) ---
    "group/expand": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 600,
            "children-class": "not-power",
            "transition-to-left": true,
            "click-to-reveal": true
        },
        "modules": [
            "custom/menu",
            "temperature#cpu",
            "custom/cpu-power",
            "temperature#gpu",
            "custom/gpu-power",
            "hyprland/language",
            "idle_inhibitor"
        ]
    },

    "group/expand#2": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 600,
            "children-class": "not-power",
            "transition-to-left": true,
            "click-to-reveal": true
        },
        "modules": [
            "custom/menumic",
            "custom/bar",
            "pulseaudio#microphone",
            "pulseaudio/slider#microphone",
            "pulseaudio"
        ]
    },

    "group/audio": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio/slider"
        ]
    },

    // --- Módulos de Hardware ---
    "cpu": {
        "interval": 1,
        "format": "   {usage}% ",
        "max-length": 10,
        "on-click": "kitty -e btop"
    },

    "memory": {
        "interval": 3,
        "format": "  {}% ",
        "max-length": 10,
        "on-click": "kitty -e btop"
    },

    "temperature#cpu": {
        "interval": 2,
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 80,
        "format": "  {temperatureC}°C ",
        "on-click": "kitty -e btop"
    },

    "custom/cpu-power": {
        "interval": 2,
        "exec": "awk '{printf \"%.1fW\\n\", $1/1000000}' /sys/devices/pci0000:00/0000:00:18.3/hwmon/hwmon*/power1_input",
        "format": "  {} ",
        "tooltip": false
    },

    "temperature#gpu": {
        "interval": 2,
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:03.1/0000:06:00.0/0000:07:00.0/0000:08:00.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 80,
        "format": "󰍹  {temperatureC}°C ",
        "on-click": "kitty -e nvtop"
    },

    "custom/gpu-power": {
        "interval": 2,
        "exec": "awk '{printf \"%.1fW\\n\", $1/1000000}' /sys/devices/pci0000:00/0000:00:03.1/0000:06:00.0/0000:07:00.0/0000:08:00.0/hwmon/hwmon*/power1_average",
        "format": " 󰚗 {}",
        "tooltip": false
    },

    // --- Áudio e Multimídia ---
    "pulseaudio": {
        "format": "{icon}",
        "nospacing": 1,
        "tooltip-format": "Volume : {volume}%",
        "format-muted": "󰝟 ",
        "format-icons": {
            "headphone": "󱡒 ",
            "default": ["󰕿 ", "󰖀 ", "󰕾 "]
        },
        "on-click": "pamixer -t",
        "on-click-right": "pavucontrol",
        "scroll-step": 5
    },

    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "󰍬",
        "format-source-muted": "󰍭",
        "on-click": "pamixer --default-source -t",
        "on-click-right": "pavucontrol",
        "tooltip-format": "{format_source} {source_desc} // {source_volume}%",
        "scroll-step": 5
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "device": "pulseaudio",
        "scroll-step": 5
    },

    "pulseaudio/slider#microphone": {
        "source": true,
        "min": 0,
        "max": 100,
        "width": 80,
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
    },

    "custom/cava": {
        "exec": "~/.config/waybar/cava.sh",
        "format": "{}",
        "format-icons": [
            "<span foreground='#cba6f7'>▁</span>",
            "<span foreground='#cba6f7'>▂</span>",
            "<span foreground='#cba6f7'>▃</span>",
            "<span foreground='#cba6f7'>▄</span>",
            "<span foreground='#89b4fa'>▅</span>",
            "<span foreground='#89b4fa'>▆</span>",
            "<span foreground='#89b4fa'>▇</span>",
            "<span foreground='#89b4fa'>█</span>"
        ],
        "on-click": "playerctl play-pause",
        "on-click-right": "qpwgraph",
        "on-click-middle": "pavucontrol",
        "restart-interval": 0,
        "return-type": "plain"
    },

    "custom/player": {
        "exec": "/home/jveju/.config/waybar/player.sh",
        "format": "{}",
        "max-length": 50,
        "interval": 1,
        "return-type": "json",
        "on-click": "playerctl play-pause",
        "on-scroll-down": "playerctl previous",
        "on-scroll-up": "playerctl next",
        "escape": true
    },

    // --- Interface e Sistema ---
    "hyprland/workspaces": {
        "active-only": false,
        "all-outputs": true,
        "format": "{icon}",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "show-special": true,
        "persistent-workspaces": { "*": [ 1, 2, 3, 4, 5 ] },
        "format-icons": {
            "active": "",
            "default": "",
            "empty": ""
        }
    },

    "hyprland/window": {
        "format": "{}",
        "rewrite": {
            "(.*) - Mozilla Firefox": "🌎 $1",
            "(.*) - fish": "> [$1]"
        },
        "separate-outputs": true
    },

    "tray": {
        "spacing": 10,
        "icon-size": 18,
        "show-passive-items": true
    },

    "clock": {
        "interval": 60,
        "format": "{:%H:%M} ",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "weeks-pos": "none",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#8fbcbb'><b>{}</b></span>",
                "days": "<span color='#8a909e'>{}</span>",
                "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
                "weekdays": "<span color='#81a1c1'><b>{}</b></span>",
                "today": "<span color='#88c0d0'><b>{}</b></span>"
            }
        }
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon}",
        "format-charging": "{icon}",
        "format-icons": [" ", " ", " ", " ", " "]
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}",
        "format-icons": ["","","","","","","","","","","","","","",""],
        "on-scroll-up": "brightnessctl -q s +5%",
        "on-scroll-down": "brightnessctl -q s 5%-"
    },

    "bluetooth": {
        "format": "",
        "interval": 30,
        "on-click": "blueman-manager"
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "", "deactivated": "" },
        "timeout": 60.5
    },

    "hyprland/language": {
        "format": " {short}"
    },

    // --- Custom Elements ---
    "custom/launcher": {
        "format": "  ",
        "on-click": "rofi -show drun -theme ~/.config/rofi/launchernovo/themes/pywal-theme-waybar.rasi"
    },

    "custom/powermenu": {
        "format": "⏻ ",
        "on-click": "~/.config/rofi/powermenu/type-2/powermenu.sh"
    },

    "custom/notification": {
        "format": "",
        "on-click": "swaync-client -t -sw"
    },

    "custom/menu": { "format": "󰅃", "rotate": 270 },
    "custom/menumic": { "format": "󰓃 " },
    "custom/bar": { "format": "|" }
}